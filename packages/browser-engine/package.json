{
  "name": "@probator/browser-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ultrafast browser harness: one goal, one typed choice per step, observable state.",
  "license": "MIT",
  "module": "src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "jev": "bun run src/inspector/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "node --check src/browser/snapshot.js && node --check src/browser/marks.js && node --check src/browser/label-layout.js && node --check src/browser/links.js && bun run typecheck",
    "build": "bun build src/index.ts --outdir dist --target bun"
  },
  "dependencies": {
    "@langchain/core": "^1.2.14",
    "@langchain/langgraph": "^1.4.18",
    "@napi-rs/canvas": "^1.0.10",
    "hono": "^4.13.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
