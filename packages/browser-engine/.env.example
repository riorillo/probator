TYPESAFE_API_KEY=
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Optional. Without HEAL_MODEL_API_KEY a run that goes nowhere keeps the rule it always had.
# The healer is asked when a run loops or its own model gives up, and it may only answer with
# the operations and elements of the page.
HEAL_MODEL_API_KEY=
HEAL_MODEL_BASE_URL=https://api.deepseek.com/v1
HEAL_MODEL=deepseek-chat
# HEAL_MODEL_REASONING=none
